{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "sortImports": {},
  "ignorePatterns": [
    "**/.next/**",
    "**/.local/**",
    "**/coverage/**",
    "styles/globals.css",
    "next-env.d.ts",
    "**/pnpm-lock.yaml",
    "**/pnpm-workspace.yaml",
    "_posts/**",
    "*.md"
  ]
}
