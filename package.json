{
  "name": "tdeekens",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "(export PATH=$(npm bin):$PATH; trap 'jobs -pr | xargs kill' EXIT; TAILWIND_MODE=watch postcss ./styles/tailwind.css -o ./styles/globals.css --watch </dev/zero & next dev)",
    "build": "next build && next-sitemap && tsx scripts/generate-blogroll-rss.ts",
    "format": "prettier --write '**/*.{js, ts, tsx}'",
    "start": "next start",
    "lint": "next lint",
    "test": "jest",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "css:dev": "TAILWIND_MODE=watch postcss ./styles/tailwind.css -o ./styles/globals.css --watch",
    "css:build": "postcss ./styles/tailwind.css -o ./styles/globals.css",
    "prepare": "husky"
  },
  "dependencies": {
    "@ai-sdk/react": "3.0.193",
    "@u-wave/react-youtube": "^0.7.4",
    "@vercel/functions": "3.6.0",
    "@vercel/speed-insights": "2.0.0",
    "accept-md-runtime": "5.0.1",
    "ai": "6.0.191",
    "gray-matter": "4.0.3",
    "next": "16.2.6",
    "next-mdx-remote": "6.0.0",
    "pino": "10.3.1",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tinykeys": "4.0.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.15",
    "@typescript-eslint/eslint-plugin": "8.60.0",
    "@typescript-eslint/parser": "8.60.0",
    "@vercel/analytics": "2.0.1",
    "autoprefixer": "10.5.0",
    "babel-jest": "30.4.1",
    "eslint": "10.4.0",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lint-staged": "17.0.5",
    "next-sitemap": "^4.2.3",
    "node-mocks-http": "1.17.2",
    "pino-pretty": "13.1.3",
    "postcss": "8.5.15",
    "postcss-cli": "11.0.1",
    "prettier": "3.8.3",
    "tailwindcss": "4.3.0",
    "ts-jest": "29.4.11",
    "ts-loader": "9.5.7",
    "tsc-files": "1.1.4",
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  }
}
